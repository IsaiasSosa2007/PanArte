<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/main.css">
    <link rel="stylesheet" href="/csub.css">
    <title>Consulta Venta</title>
</head>
<body>
    <div class="contenedor">
        <header>
            <div class="divImg">
                <img src="/LogoPanArte.png" alt="">
            </div>
            <nav>
                <div>
                    <a href="/"><button>Home</button></a>
                    <a href="/clientes"><button>Clientes</button></a>
                    <a href="/empleados"><button>Empleados</button></a>
                    <a href="/proveedores"><button>Proveedores</button></a>
                </div>
                <div>
                    <a href="/ventas"><button>Ventas</button></a>
                    <a href="/pedidos"><button>Pedidos</button></a>
                    <a href="/productos"><button>Productos</button></a>
                    <a href="/ingredientes"><button>Ingrediente</button></a>
                    <a href="/recetas"><button>Recetas</button></a>
                </div>
            </nav>
        </header>
        <div class="divSubt">
            <h2>Consultar Ventas</h2>
        </div>
        <nav class="navSub">
            <a href="/ventas/alta"><button>Alta</button></a>
            <a href="/ventas/baja"><button>Baja</button></a>
            <a href="/ventas/mod"><button>Modificar</button></a>
            <a href="/ventas/cons"><button>Consultar</button></a>
            <a href="/ventas/mostrarTodo"><button>Mostrar Todo</button></a>
        </nav>

        <form onsubmit="buscar(event)">
            <label for="idVentIdBusq">Buscar venta por ID:
                <input type="number" min="1" name="ventBusq" id="idVentIdBusq">
            </label>
            <input type="submit" value="Buscar">
        </form>
        <%
        if(busqueda!=null){%>
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Fecha</th>
                        <th>Hora</th>
                        <th>Total</th>
                        <th>Cant. Productos</th>
                        <th>Precio Unit. Actual</th>
                        <th>Subtotal</th>
                        <th>Descuento</th>
                        <th>ID Cliente</th>
                        <th>ID Producto</th>
                        <th>ID Empleado</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- id_factura, fecha, hora, total, cantidad_productos, precio_unit_actual, sub_total, descuento, clientes_frecuentes_id, productos_id, empleados_id -->
            <%busqueda.forEach(busq => { 
                let fecha=`${busq.fecha.getDate()}/${busq.fecha.getMonth()+1}/${busq.fecha.getFullYear()}`%>
                %>
                <tr>
                    <td><%=busq.id_factura%></td>
                    <td><%=fecha%></td>
                    <td><%=busq.hora%></td>
                    <td><%=busq.total%></td>
                    <td><%=busq.cantidad_productos%></td>
                    <td><%=busq.precio_unit_actual%></td>
                    <td><%=busq.sub_total%></td>
                    <td><%=busq.descuento%></td>
                    <td><%=busq.clientes_frecuentes_id%></td>
                    <td><%=busq.productos_id%></td>
                    <td><%=busq.empleados_id%></td>
                </tr>
            <%})%>
                </tbody>
            </table>
       <%}%>
        
        <script>
            function buscar(event) {
                event.preventDefault();
                let ventBusq = document.getElementById('idVentIdBusq').value;
                window.location.href = `/ventas/buscar/${ventBusq}`;
                document.getElementById('idVentIdBusq').value = "";
            }
        </script>
    </div>
</body>
</html>