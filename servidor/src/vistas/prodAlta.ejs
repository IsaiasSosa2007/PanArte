<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/main.css">
    <link rel="stylesheet" href="/csub.css">
    <title>Alta Producto</title>
</head>
<body>
    <div class="contenedor">
        <header>
            <div class="divImg">
                <img src="/LogoPanArte.png" alt="">
            </div>
            <nav>
                <div>
                    <a href="/"><button>Home</button></a>
                    <a href="/clientes"><button>Clientes</button></a>
                    <a href="/empleados"><button>Empleados</button></a>
                    <a href="/proveedores"><button>Proveedores</button></a>
                </div>
                <div>
                    <a href="/ventas"><button>Ventas</button></a>
                    <a href="/pedidos"><button>Pedidos</button></a>
                    <a href="/productos"><button>Productos</button></a>
                    <a href="/ingredientes"><button>Ingrediente</button></a>
                </div>
            </nav>
        </header>
        <div class="divSubt">
            <h2>Altas Productos</h2>
        </div>
        <nav class="navSub">
            <a href="/productos/alta"><button>Alta</button></a>
            <a href="/productos/baja"><button>Baja</button></a>
            <a href="/productos/mod"><button>Modificar</button></a>
            <a href="/productos/cons"><button>Consultar</button></a>
            <a href="/productos/mostrarTodo"><button>Mostrar Todo</button></a>
        </nav>
        <form action="/productos/prodAlta" method="post">
            <label for="idProdNom">Nombre
                <input type="text" name="prodNom" id="idProdNom">
            </label>
            <label for="idProdDesc">Descripcion
                <input type="text" name="prodDesc" id="idProdDesc">
            </label>
            <label for="idProdPrec">Precio
                <input type="number" name="prodPrec" id="idProdPrec">
            </label>
            <label for="idProdStock">Productos en stock
                <input type="number" name="prodStock" id="idProdStock">
            </label>
            <label for="idProdCat">Categoria
                <input type="text" name="prodCat" id="idProdCat">
            </label>
        </form>
    </div>
</body>
</html>