<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/main.css">
    <link rel="stylesheet" href="/csub.css">
    <title>Consulta Producto</title>
</head>
<body>
    <div class="contenedor">
        <header>
            <div class="divImg">
                <img src="/LogoPanArte.png" alt="">
            </div>
            <nav>
                <div>
                    <a href="/"><button>Home</button></a>
                    <a href="/clientes"><button>Clientes</button></a>
                    <a href="/empleados"><button>Empleados</button></a>
                    <a href="/proveedores"><button>Proveedores</button></a>
                </div>
                <div>
                    <a href="/ventas"><button>Ventas</button></a>
                    <a href="/pedidos"><button>Pedidos</button></a>
                    <a href="/productos"><button>Productos</button></a>
                    <a href="/ingredientes"><button>Ingrediente</button></a>
                    <a href="/recetas"><button>Recetas</button></a>
                </div>
            </nav>
        </header>
        <div class="divSubt">
            <h2>Consultar Productos</h2>
        </div>
        <nav class="navSub">
            <a href="/productos/alta"><button>Alta</button></a>
            <a href="/productos/baja"><button>Baja</button></a>
            <a href="/productos/mod"><button>Modificar</button></a>
            <a href="/productos/cons"><button>Consultar</button></a>
            <a href="/productos/mostrarTodo"><button>Mostrar Todo</button></a>
        </nav>

        <form onsubmit="buscar(event)">
            <label for="idProdIdBusq">Buscar producto por ID:
                <input type="number" min="1" name="prodBusq" id="idProdIdBusq">
            </label>
            <input type="submit" value="Buscar">
        </form>
        <%
        if(busqueda!=null){%>
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nombre</th>
                        <th>Descripcion</th>
                        <th>Precio</th>
                        <th>Stock</th>
                        <th>Categoria ID</th>
                        <th>Receta ID</th>
                    </tr>
                </thead>
                <tbody>
            <%busqueda.forEach(busq=>{%>
                <tr>
                    <td><%=busq.id%></td>
                    <td><%=busq.nombre%></td>
                    <td><%=busq.descripcion%></td>
                    <td><%=busq.precio%></td>
                    <td><%=busq.productos_stock%></td>
                    <td><%=busq.categorias_id%></td>
                    <td><%=busq.recetas_id%></td>
                </tr>
            <%})%>
                </tbody>
            </table>
       <%}%>
        
        <script>
            function buscar(event) {
                event.preventDefault();
                let prodBusq = document.getElementById('idProdIdBusq').value;
                window.location.href = `/productos/buscar/${prodBusq}`;
                document.getElementById('idProdIdBusq').value = "";
            }
        </script>
    </div>
</body>
</html>