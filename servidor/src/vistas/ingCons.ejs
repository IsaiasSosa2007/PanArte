<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/main.css">
    <link rel="stylesheet" href="/csub.css">
    <title>Consulta Ingrediente</title>
</head>
<body>
    <div class="contenedor">
        <header>
            <div class="divImg">
                <img src="/LogoPanArte.png" alt="">
            </div>
            <nav>
                <div>
                    <a href="/"><button>Home</button></a>
                    <a href="/clientes"><button>Clientes</button></a>
                    <a href="/empleados"><button>Empleados</button></a>
                    <a href="/proveedores"><button>Proveedores</button></a>
                </div>
                <div>
                    <a href="/ventas"><button>Ventas</button></a>
                    <a href="/pedidos"><button>Pedidos</button></a>
                    <a href="/productos"><button>Productos</button></a>
                    <a href="/ingredientes"><button>Ingrediente</button></a>
                </div>
            </nav>
        </header>
        <div class="divSubt">
            <h2>Consultar Ingredientes</h2>
        </div>
        <nav class="navSub">
            <a href="/ingredientes/alta"><button>Alta</button></a>
            <a href="/ingredientes/baja"><button>Baja</button></a>
            <a href="/ingredientes/mod"><button>Modificar</button></a>
            <a href="/ingredientes/cons"><button>Consultar</button></a>
            <a href="/ingredientes/mostrarTodo"><button>Mostrar Todo</button></a>
        </nav>

        <form onsubmit="buscar(event)">
            <label for="idIngIdBusq">Buscar ingrediente por ID:
                <input type="number" min="1" name="ingBusq" id="idIngIdBusq">
            </label>
            <input type="submit" value="Buscar">
        </form>
        <%
        if(busqueda!=null){%>
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nombre</th>
                        <th>Stock</th>
                        <th>Unidad Medida</th>
                        <th>Proveedores id/nit</th>
                    </tr>
                </thead>
                <!-- id, nombre, cantidad_stock, unidad_medida, proveedores_id/nit -->
                <tbody>
            <%busqueda.forEach(busq=>{%>
                <tr>
                    <td><%=busq.id%></td>
                    <td><%=busq.nombre%></td>
                    <td><%=busq.cantidad_stock%></td>
                    <td><%=busq.unidad_medida%></td>
                    <td><%=busq.proveedores_id%></td>
                </tr>

            <%})%>
                </tbody>
            </table>
       <%}%>
        
        <script>
            function buscar(event) {
                event.preventDefault();
                let ingBusq = document.getElementById('idIngIdBusq').value;
                window.location.href = `/ingredientes/buscar/${ingBusq}`;
                document.getElementById('idIngIdBusq').value = "";
            }
        </script>
    </div>
</body>
</html>