<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/main.css">
    <link rel="stylesheet" href="/csub.css">
    <title>Consulta Empleado</title>
</head>
<body>
    <div class="contenedor">
        <header>
            <div class="divImg">
                <img src="/LogoPanArte.png" alt="">
            </div>
            <nav>
                <div>
                    <a href="/"><button>Home</button></a>
                    <a href="/clientes"><button>Clientes</button></a>
                    <a href="/empleados"><button>Empleados</button></a>
                    <a href="/proveedores"><button>Proveedores</button></a>
                </div>
                <div>
                    <a href="/ventas"><button>Ventas</button></a>
                    <a href="/pedidos"><button>Pedidos</button></a>
                    <a href="/productos"><button>Productos</button></a>
                    <a href="/ingredientes"><button>Ingrediente</button></a>
                </div>
            </nav>
        </header>
        <div class="divSubt">
            <h2>Consultar Empleados</h2>
        </div>
        <nav class="navSub">
            <a href="/empleados/alta"><button>Alta</button></a>
            <a href="/empleados/baja"><button>Baja</button></a>
            <a href="/empleados/mod"><button>Modificar</button></a>
            <a href="/empleados/cons"><button>Consultar</button></a>
            <a href="/empleados/mostrarTodo"><button>Mostrar Todo</button></a>
        </nav>

        <form onsubmit="buscar(event)">
            <label for="idEmpIdBusq">Buscar empleado por ID:
                <input type="number" min="1" name="empBusq" id="idEmpIdBusq">
            </label>
            <input type="submit" value="Buscar">
        </form>
        <%
        if(busqueda!=null){%>
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nombre</th>
                        <th>Apellido</th>
                        <th>Puesto</th>
                        <th>Fecha contratacion</th>
                        <th>Telefono</th>
                    </tr>
                </thead>
                <tbody>
            <%busqueda.forEach(busq=>{
                let fecha=`${busq.fecha_contratacion.getDate()}/${busq.fecha_contratacion.getMonth()+1}/${busq.fecha_contratacion.getFullYear()}`%>
                %>
                <tr>
                    <td><%=busq.id%></td>
                    <td><%=busq.nombre%></td>
                    <td><%=busq.apellido%></td>
                    <td><%=busq.puesto%></td>
                    <td><%=fecha%></td>
                    <td><%=busq.telefono%></td>
                </tr>

            <%})%>
                </tbody>
            </table>
       <%}%>
        
        <script>
            function buscar(event) {
                event.preventDefault();
                let empBusq = document.getElementById('idEmpIdBusq').value;
                window.location.href = `/empleados/buscar/${empBusq}`;
                document.getElementById('idCliIdBusq').value = "";
            }
        </script>
    </div>
</body>
</html>