<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/main.css">
    <link rel="stylesheet" href="/csub.css">
    <title>Pedido</title>
</head>
<body>
    <div class="contenedor">
        <header>
            <div class="divImg">
                <img src="/LogoPanArte.png" alt="">
            </div>
            <nav>
                <div>
                    <a href="/"><button>Home</button></a>
                    <a href="/clientes"><button>Clientes</button></a>
                    <a href="/empleados"><button>Empleados</button></a>
                    <a href="/proveedores"><button>Proveedores</button></a>
                </div>
                <div>
                    <a href="/ventas"><button>Ventas</button></a>
                    <a href="/pedidos"><button>Pedidos</button></a>
                    <a href="/productos"><button>Productos</button></a>
                    <a href="/ingredientes"><button>Ingrediente</button></a>
                    <a href="/recetas"><button>Recetas</button></a>
                </div>
            </nav>
        </header>
        <div class="divSubt">
            <h2>Mostrar Todo Pedidos</h2>
        </div>
        <nav class="navSub">
            <a href="/pedidos/alta"><button>Alta</button></a>
            <a href="/pedidos/baja"><button>Baja</button></a>
            <a href="/pedidos/mod"><button>Modificar</button></a>
            <a href="/pedidos/cons"><button>Consultar</button></a>
            <a href="/pedidos/mostrarTodo"><button>Mostrar Todo</button></a>
        </nav>
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Fecha orig</th>
                    <th>Hora orig</th>
                    <th>Total</th>
                    <th>Cantidad</th>
                    <th>Fecha Entrega</th>
                    <th>Hora Entrega</th>
                    <th>Estado</th>
                    <th>Sub Total</th>
                    <th>Descuento</th>
                    <th>Cliente ID</th>
                    <th>Empleado ID</th>
                    <th>Producto ID</th>
                </tr>
            </thead>
            <tbody>
                <%
                if(registros.length>0){
                    registros.forEach(ped => { 
                        let fechaPedido=`${ped.fecha_pedido.getDate()}/${ped.fecha_pedido.getMonth()+1}/${ped.fecha_pedido.getFullYear()}`
                        let fechaEntrega=`${ped.fecha_entrega.getDate()}/${ped.fecha_entrega.getMonth()+1}/${ped.fecha_entrega.getFullYear()}`%>
                        <tr>
                            <td><%=ped.id_pedido%></td>
                            <td><%=fechaPedido%></td>
                            <td><%=ped.hora_pedido%></td>
                            <td><%=ped.total%></td>
                            <td><%=ped.cantidad_productos%></td>
                            <td><%=fechaEntrega%></td>
                            <td><%=ped.hora_entrega%></td>
                            <td><%=ped.estado_pedido%></td>
                            <td><%=ped.sub_total%></td>
                            <td><%=ped.descuento%></td>
                            <td><%=ped.clientes_frecuentes_id%></td>
                            <td><%=ped.empleados_id%></td>
                            <td><%=ped.productos_id%></td>
                        </tr>
                    <%});
                }
                else{%>
                <p>No hay ingredientes cargados</p><%}%>
            </tbody>
        </table>
    </div>
</body>
</html>