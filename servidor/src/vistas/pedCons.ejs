<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/main.css">
    <link rel="stylesheet" href="/csub.css">
    <title>Consulta Pedido</title>
</head>
<body>
    <div class="contenedor">
        <header>
            <div class="divImg">
                <img src="/LogoPanArte.png" alt="">
            </div>
            <nav>
                <div>
                    <a href="/"><button>Home</button></a>
                    <a href="/clientes"><button>Clientes</button></a>
                    <a href="/empleados"><button>Empleados</button></a>
                    <a href="/proveedores"><button>Proveedores</button></a>
                </div>
                <div>
                    <a href="/ventas"><button>Ventas</button></a>
                    <a href="/pedidos"><button>Pedidos</button></a>
                    <a href="/productos"><button>Productos</button></a>
                    <a href="/ingredientes"><button>Ingrediente</button></a>
                </div>
            </nav>
        </header>
        <div class="divSubt">
            <h2>Consultar Pedidos</h2>
        </div>
        <nav class="navSub">
            <a href="/pedidos/alta"><button>Alta</button></a>
            <a href="/pedidos/baja"><button>Baja</button></a>
            <a href="/pedidos/mod"><button>Modificar</button></a>
            <a href="/pedidos/cons"><button>Consultar</button></a>
            <a href="/pedidos/mostrarTodo"><button>Mostrar Todo</button></a>
        </nav>

        <form onsubmit="buscar(event)">
            <label for="idPedIdBusq">Buscar pedidos por ID:
                <input type="number" min="1" name="pedBusq" id="idPedIdBusq">
            </label>
            <input type="submit" value="Buscar">
        </form>
        <%
        if(busqueda!=null){%>
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Fecha Pedido</th>
                        <th>Hora Pedido</th>
                        <th>Total</th>
                        <th>Cantidad Productos</th>
                        <th>Fecha Entrega</th>
                        <th>Hora Entrega</th>
                        <th>Estado Pedido</th>
                        <th>Sub-total</th>
                        <th>Descuento</th>
                        <th>Cliente ID</th>
                        <th>Empleado ID</th>
                        <th>Producto ID</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- SELECT id_pedido, fecha_pedido, hora_pedido, total, cantidad_productos, fecha_entrega, hora_entrega, estado_pedido, sub_total, descuento, clientes_frecuentes_id, empleados_id, productos_id FROM pedidos where id=; -->
            <%busqueda.forEach(busq => { 
                let fechaPedido=`${busq.fecha_pedido.getDate()}/${busq.fecha_pedido.getMonth()+1}/${busq.fecha_pedido.getFullYear()}`
                let fechaEntrega=`${busq.fecha_entrega.getDate()}/${busq.fecha_entrega.getMonth()+1}/${busq.fecha_entrega.getFullYear()}`%>%>
                <tr>
                    <td><%=busq.id_pedido%></td>
                    <td><%=fechaPedido%></td>
                    <td><%=busq.hora_pedido%></td>
                    <td><%=busq.total%></td>
                    <td><%=busq.cantidad_productos%></td>
                    <td><%=fechaEntrega%></td>
                    <td><%=busq.hora_entrega%></td>
                    <td><%=busq.estado_pedido%></td>
                    <td><%=busq.sub_total%></td>
                    <td><%=busq.descuento%></td>
                    <td><%=busq.clientes_frecuentes_id%></td>
                    <td><%=busq.empleados_id%></td>
                    <td><%=busq.productos_id%></td>
                </tr>
            <%})%>
                </tbody>
            </table>
       <%}%>
        
        <script>
            function buscar(event) {
                event.preventDefault();
                let pedBusq = document.getElementById('idPedIdBusq').value;
                window.location.href = `/pedidos/buscar/${pedBusq}`;
                document.getElementById('idPedIdBusq').value = "";
            }
        </script>
    </div>
</body>
</html>