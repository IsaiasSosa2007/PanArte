<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/main.css">
    <link rel="stylesheet" href="/csub.css">
    <title>Alta Venta</title>
</head>
<body>
    <div class="contenedor">
        <header>
            <div class="divImg">
                <img src="/LogoPanArte.png" alt="">
            </div>
            <nav>
                <div>
                    <a href="/"><button>Home</button></a>
                    <a href="/clientes"><button>Clientes</button></a>
                    <a href="/empleados"><button>Empleados</button></a>
                    <a href="/proveedores"><button>Proveedores</button></a>
                </div>
                <div>
                    <a href="/ventas"><button>Ventas</button></a>
                    <a href="/pedidos"><button>Pedidos</button></a>
                    <a href="/productos"><button>Productos</button></a>
                    <a href="/ingredientes"><button>Ingrediente</button></a>
                </div>
            </nav>
        </header>
        <div class="divSubt">
            <h2>Altas Ventas</h2>
        </div>
        <nav class="navSub">
            <a href="/ventas/alta"><button>Alta</button></a>
            <a href="/ventas/baja"><button>Baja</button></a>
            <a href="/ventas/mod"><button>Modificar</button></a>
            <a href="/ventas/cons"><button>Consultar</button></a>
            <a href="/ventas/mostrarTodo"><button>Mostrar Todo</button></a>
        </nav>
        <form action="/ventas/ventNuevo" method="post">
            <label for="idVentFecha">Fecha
                <input type="text" name="ventFecha" id="idVentFecha">
            </label>
            <label for="idVentHora">Hora
                <input type="text" name="ventHora" id="idVentHora">
            </label>
            <label for="idVentTotal">Total
                <input type="text" name="ventTotal" id="idVentTotal">
            </label>
            <label for="idVentCantProd">Cantidad del producto
                <input type="text" name="ventCantProd" id="idVentCantProd">
            </label>
            <label for="idVentPrecioUniAct">Precio unitario actual
                <input type="text" name="ventPrecioUniAct" id="idVentPrecioUniAct">
            </label>
            <label for="idVentProdId">Producto id
                <input type="text" name="ventProdId" id="idVentProdId" list="listProductos">
            </label>
            <label for="idVentEmpId">Empleado id
                <input type="text" name="ventEmpId" id="idVentEmpId">
            </label>
            <input type="submit" value="enviar">
        </form>
        <%
        if(productos.length>0){%>
            <datalist id="listProductos">
                <option value="1"><%=productos.nombre[0]%></option>
            </datalist>
        <%}%>
    </div>
</body>
</html>