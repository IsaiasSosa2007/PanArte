<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/main.css">
    <link rel="stylesheet" href="/csub.css">
    <title>Empleado</title>
</head>
<body>
    <div class="contenedor">
        <header>
            <div class="divImg">
                <img src="/LogoPanArte.png" alt="">
            </div>
            <nav>
                <div>
                    <a href="/"><button>Home</button></a>
                    <a href="/clientes"><button>Clientes</button></a>
                    <a href="/empleados"><button>Empleados</button></a>
                    <a href="/proveedores"><button>Proveedores</button></a>
                </div>
                <div>
                    <a href="/ventas"><button>Ventas</button></a>
                    <a href="/pedidos"><button>Pedidos</button></a>
                    <a href="/productos"><button>Productos</button></a>
                    <a href="/ingredientes"><button>Ingrediente</button></a>
                    <a href="/recetas"><button>Recetas</button></a>
                </div>
            </nav>
        </header>
        <div class="divSubt">
            <h2>Mostrar Todos Empleados</h2>
        </div>
        <nav class="navSub">
            <a href="/empleados/alta"><button>Alta</button></a>
            <a href="/empleados/baja"><button>Baja</button></a>
            <a href="/empleados/mod"><button>Modificar</button></a>
            <a href="/empleados/cons"><button>Consultar</button></a>
            <a href="/empleados/mostrarTodo"><button>Mostrar Todo</button></a>
        </nav>
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Apellido</th>
                    <th>Puesto</th>
                    <th>Telefono</th>
                    <th>Fecha Contratacion</th>
                </tr>
            </thead>
            <tbody>
                <%
                if(registros.length>0){
                    registros.forEach(emp => { 
                        let fecha=`${emp.fecha_contratacion.getDate()}/${emp.fecha_contratacion.getMonth()+1}/${emp.fecha_contratacion.getFullYear()}`%>
                        <tr>
                            <td><%=emp.id%></td>
                            <td><%=emp.nombre%></td>
                            <td><%=emp.apellido%></td>
                            <td><%=emp.puesto%></td>
                            <td><%=emp.telefono%></td>
                            <td><%=fecha%></td>
                        </tr>
                    <%});
                }
                else{%>
                <p>No hay empleados cargados</p><%}%>
            </tbody>
        </table>
    </div>
</body>
</html>