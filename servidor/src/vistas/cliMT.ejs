<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/main.css">
    <link rel="stylesheet" href="/csub.css">
    <title>Cliente</title>
</head>
<body>
    <div class="contenedor">
        <header>
            <div class="divImg">
                <img src="/LogoPanArte.png" alt="">
            </div>
            <nav>
                <div>
                    <a href="/"><button>Home</button></a>
                    <a href="/clientes"><button>Clientes</button></a>
                    <a href="/empleados"><button>Empleados</button></a>
                    <a href="/proveedores"><button>Proveedores</button></a>
                </div>
                <div>
                    <a href="/ventas"><button>Ventas</button></a>
                    <a href="/pedidos"><button>Pedidos</button></a>
                    <a href="/productos"><button>Productos</button></a>
                    <a href="/ingredientes"><button>Ingrediente</button></a>
                </div>
            </nav>
        </header>
        <div class="divSubt">
            <h2>Mostrar Todos Clientes</h2>
        </div>
        <nav class="navSub">
            <a href="/clientes/alta"><button>Alta</button></a>
            <a href="/clientes/baja"><button>Baja</button></a>
            <a href="/clientes/mod"><button>Modificar</button></a>
            <a href="/clientes/cons"><button>Consultar</button></a>
            <a href="/clientes/mostrarTodo"><button>Mostrar Todo</button></a>
        </nav>

        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>DNI</th>
                    <th>Nombre</th>
                    <th>Apellido</th>
                    <th>Telefono</th>
                    <th>Email</th>
                    <th>Descuento</th>
                </tr>
            </thead>
            <tbody>
                <%
                if(registros.length>0){
                    registros.forEach(cli => { 
                        console.log(typeof cli.descuento)%>
                        <tr>
                            <td><%=cli.id%></td>
                            <td><%=cli.dni%></td>
                            <td><%=cli.nombre%></td>
                            <td><%=cli.apellido%></td>
                            <td><%=cli.email%></td>
                            <td><%=cli.telefono%></td>
                            <td><%=cli.descuento%></td>
                        </tr>
                    <%});
                }
                else{%>
                <p>No hay clientes cargados</p><%}%>
            </tbody>
        </table>
    </div>
</body>
</html>