    <link rel="stylesheet" href="/main.css">
    <link rel="stylesheet" href="/csub.css">
    <title>Alta Empleado</title>
</head>
<body>
    <div class="contenedor">
        <header>
            <div class="divImg">
                <img src="/LogoPanArte.png" alt="">
            </div>
            <nav>
                <div>
                    <a href="/"><button>Home</button></a>
                    <a href="/clientes"><button>Clientes</button></a>
                    <a href="/empleados"><button>Empleados</button></a>
                    <a href="/proveedores"><button>Proveedores</button></a>
                </div>
                <div>
                    <a href="/ventas"><button>Ventas</button></a>
                    <a href="/pedidos"><button>Pedidos</button></a>
                    <a href="/productos"><button>Productos</button></a>
                    <a href="/ingredientes"><button>Ingrediente</button></a>
                </div>
            </nav>
        </header>
        <div class="divSubt">
            <h2>Altas Empleados</h2>
        </div>
        <nav class="navSub">
            <a href="/empleados/alta"><button>Alta</button></a>
            <a href="/empleados/baja"><button>Baja</button></a>
            <a href="/empleados/mod"><button>Modificar</button></a>
            <a href="/empleados/cons"><button>Consultar</button></a>
            <a href="/empleados/mostrarTodo"><button>Mostrar Todo</button></a>
        </nav>
        <form action="/empleados/empNuevo" method="post">
            <label for="idEmpNom">Nombre
                <input type="text" name="empNom" id="idEmpNom">
            </label>
            <label for="idEmpApe">Apellido
                <input type="text" name="empApe" id="idEmpApe">
            </label>
            <label for="idEmpPuesto">Puesto
                <input type="text" name="empPuesto" id="idEmpPuesto">
            </label>
            <!-- Qué pasa si ingresa cualquier cosa? deberia tirar un error? se puede hacer 
            <select name="" id="">
                <option value=""></option>
            </select>
            pero con las otras opciones qué? Deberia tirar un error si ingresa algun dato no valido.
            (letras el tel, numeros en nombre, etc)
            Cómo coño se hace es la pregunta -->
            <label for="idEmpTel">Telefono
                <input type="text" name="empTel" id="idEmpTel">
            </label>
            <label for="idEmpFecha">Fecha de contratacion
                <input type="date" name="empFecha" id="idEmpFecha">
            </label>
            <input type="submit" value="enviar">
        </form>
        <!-- <datalist id="puestos">
            <option value="Cajero">Cajero</option>
