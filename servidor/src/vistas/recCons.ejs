<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/main.css">
    <link rel="stylesheet" href="/csub.css">
    <title>Consulta Recetas</title>
</head>
<body>
    <div class="contenedor">
        <header>
            <div class="divImg">
                <img src="/LogoPanArte.png" alt="">
            </div>
            <nav>
                <div>
                    <a href="/"><button>Home</button></a>
                    <a href="/clientes"><button>Clientes</button></a>
                    <a href="/empleados"><button>Empleados</button></a>
                    <a href="/proveedores"><button>Proveedores</button></a>
                </div>
                <div>
                    <a href="/ventas"><button>Ventas</button></a>
                    <a href="/pedidos"><button>Pedidos</button></a>
                    <a href="/productos"><button>Productos</button></a>
                    <a href="/ingredientes"><button>Ingrediente</button></a>
                    <a href="/recetas"><button>Recetas</button></a>
                </div>
            </nav>
        </header>
        <div class="divSubt">
            <h2>Consultar Recetas</h2>
        </div>
        <nav class="navSub">
            <a href="/recetas/alta"><button>Alta</button></a>
            <a href="/recetas/baja"><button>Baja</button></a>
            <a href="/recetas/mod"><button>Modificar</button></a>
            <a href="/recetas/cons"><button>Consultar</button></a>
            <a href="/recetas/mostrarTodo"><button>Mostrar Todo</button></a>
        </nav>

         <form onsubmit="buscar(event)">
            <label for="idRecIdBusq">Buscar receta por ID:
                <input type="number" min="1" name="recBusq" id="idRecIdBusq" required>
            </label>
            <input type="submit" value="Buscar">
        </form>

        <% if (busqueda) { %>
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                </tr>
            </thead>
            <tbody>
                <% busqueda.forEach(busq => { %>
                <tr>
                    <td><%= busq.id %></td>
                    <td><%= busq.nombre %></td>
                </tr>
                <% }) %>
            </tbody>
        </table>
        <% } %>
        <script>
            function buscar(event) {
                event.preventDefault();
                const id = document.getElementById('idRecIdBusq').value;
                window.location.href = `/recetas/buscar/${id}`;
                document.getElementById('idVentIdBusq').value = "";
            }
        </script>
    </div>
</body>
</html>