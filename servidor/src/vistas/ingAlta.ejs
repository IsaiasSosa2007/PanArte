            </label>
            <label for="idIngUniMed">Unidad de medida
                <input type="text" name="ingUniMed" id="idIngUniMed">
            </label>
            <label for="idIngProv">Proveedor
                <input type="text" name="ingProv" id="idIngProv">
            </label>
            <!-- Debería tambien ingresar el proveedor?
            Deberia simplemente ingresar la cantidad de producto a reponer, 
            actualizando la cantidad del producto ya existente en la bdd -->
        </form>
