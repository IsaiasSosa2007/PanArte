<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/main.css">
    <link rel="stylesheet" href="/csub.css">
    <title>Consulta Proveedor</title>
</head>
<body>
    <div class="contenedor">
        <header>
            <div class="divImg">
                <img src="/LogoPanArte.png" alt="">
            </div>
            <nav>
                <div>
                    <a href="/"><button>Home</button></a>
                    <a href="/clientes"><button>Clientes</button></a>
                    <a href="/empleados"><button>Empleados</button></a>
                    <a href="/proveedores"><button>Proveedores</button></a>
                </div>
                <div>
                    <a href="/ventas"><button>Ventas</button></a>
                    <a href="/pedidos"><button>Pedidos</button></a>
                    <a href="/productos"><button>Productos</button></a>
                    <a href="/ingredientes"><button>Ingrediente</button></a>
                </div>
            </nav>
        </header>
        <div class="divSubt">
            <h2>Consultar Proveedores</h2>
        </div>
        <nav class="navSub">
            <a href="/proveedores/alta"><button>Alta</button></a>
            <a href="/proveedores/baja"><button>Baja</button></a>
            <a href="/proveedores/mod"><button>Modificar</button></a>
            <a href="/proveedores/cons"><button>Consultar</button></a>
            <a href="/proveedores/mostrarTodo"><button>Mostrar Todo</button></a>
        </nav>

        <form onsubmit="buscar(event)">
            <label for="idProvIdBusq">Buscar proveedor por ID:
                <input type="number" min="1" name="provBusq" id="idProvIdBusq">
            </label>
            <input type="submit" value="Buscar">
        </form>
        <%
        if(busqueda!=null){%>
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nombre Empresa</th>
                        <th>Telefono</th>
                        <th>Direccion</th>
                    </tr>
                </thead>
                <tbody>
            <%busqueda.forEach(busq=>{%>
                <tr>
                    <td><%=busq.id%></td>
                    <td><%=busq.nombre_empresa%></td>
                    <td><%=busq.telefono%></td>
                    <td><%=busq.direccion%></td>
                </tr>

            <%})%>
                </tbody>
            </table>
       <%}%>
        
        <script>
            function buscar(event) {
                event.preventDefault();
                let provBusq = document.getElementById('idProvIdBusq').value;
                window.location.href = `/proveedores/buscar/${provBusq}`;
                document.getElementById('idProvIdBusq').value = "";
            }
        </script>
    </div>
</body>
</html>