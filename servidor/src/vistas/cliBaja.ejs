<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/main.css">
    <link rel="stylesheet" href="/csub.css">
    <title>Baja Cliente</title>
</head>
<body>
    <div class="contenedor">
        <header>
            <div class="divImg">
                <img src="/LogoPanArte.png" alt="">
            </div>
            <nav>
                <div>
                    <a href="/"><button>Home</button></a>
                    <a href="/clientes"><button>Clientes</button></a>
                    <a href="/empleados"><button>Empleados</button></a>
                    <a href="/proveedores"><button>Proveedores</button></a>
                </div>
                <div>
                    <a href="/ventas"><button>Ventas</button></a>
                    <a href="/pedidos"><button>Pedidos</button></a>
                    <a href="/productos"><button>Productos</button></a>
                    <a href="/ingredientes"><button>Ingrediente</button></a>
                    <a href="/recetas"><button>Recetas</button></a>
                </div>
            </nav>
        </header>
        <div class="divSubt">
            <h2>Bajas Clientes</h2>
        </div>
        <nav class="navSub">
            <a href="/clientes/alta"><button>Alta</button></a>
            <a href="/clientes/baja"><button>Baja</button></a>
            <a href="/clientes/mod"><button>Modificar</button></a>
            <a href="/clientes/cons"><button>Consultar</button></a>
            <a href="/clientes/mostrarTodo"><button>Mostrar Todo</button></a>
        </nav>

        <form onsubmit="buscar(event)">
            <label for="idCliIdBusq">ID del cliente a eliminar:
                <input type="number" min="1" name="cliBusq" id="idCliIdBusq">
            </label>
            <input type="submit" value="Buscar">
        </form>

        <%if(mensaje!=""){%>
            <p><%=mensaje%></p>
        <%}%>

        <%if(cliente!=null){%>
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>DNI</th>
                        <th>Nombre</th>
                        <th>Apellido</th>
                        <th>Telefono</th>
                        <th>Email</th>
                        <th>Descuento</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><%=cliente.id%></td>
                        <td><%=cliente.dni%></td>
                        <td><%=cliente.nombre%></td>
                        <td><%=cliente.apellido%></td>
                        <td><%=cliente.telefono%></td>
                        <td><%=cliente.email%></td>
                        <td><%=cliente.descuento%></td>
                    </tr>
                </tbody>
            </table>
            <!-- confirm() muestra el cartel de "Aceptar / Cancelar" del navegador -->
            <form action="/clientes/baja/eliminar" method="post" onsubmit="return confirm('¿Seguro que querés eliminar este cliente?')">
                <input type="hidden" name="cliId" value="<%=cliente.id%>">
                <input type="submit" value="Eliminar">
            </form>
        <%}%>

        <script>
            function buscar(event) {
                event.preventDefault();
                let cliBusq = document.getElementById('idCliIdBusq').value;
                window.location.href = `/clientes/baja/buscar/${cliBusq}`;
            }
        </script>
    </div>
</body>
</html>
