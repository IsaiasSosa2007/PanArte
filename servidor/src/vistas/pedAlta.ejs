<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/main.css">
    <link rel="stylesheet" href="/csub.css">
    <title>Alta Pedido</title>
</head>
<body>
    <div class="contenedor">
        <header>
            <div class="divImg">
                <img src="/LogoPanArte.png" alt="">
            </div>
            <nav>
                <div>
                    <a href="/"><button>Home</button></a>
                    <a href="/clientes"><button>Clientes</button></a>
                    <a href="/empleados"><button>Empleados</button></a>
                    <a href="/proveedores"><button>Proveedores</button></a>
                </div>
                <div>
                    <a href="/ventas"><button>Ventas</button></a>
                    <a href="/pedidos"><button>Pedidos</button></a>
                    <a href="/productos"><button>Productos</button></a>
                    <a href="/ingredientes"><button>Ingrediente</button></a>
                </div>
            </nav>
        </header>
        <div class="divSubt">
            <h2>Altas Pedidos</h2>
        </div>
        <nav class="navSub">
            <a href="/pedidos/alta"><button>Alta</button></a>
            <a href="/pedidos/baja"><button>Baja</button></a>
            <a href="/pedidos/mod"><button>Modificar</button></a>
            <a href="/pedidos/cons"><button>Consultar</button></a>
            <a href="/pedidos/mostrarTodo"><button>Mostrar Todo</button></a>
        </nav>
        <form action="/pedidos/pedNuevo" method="post">
            <label for="idPedCantProd">Cantidad de productos
                <input type="number" name="pedCantProd" id="idPedCantProd">
            </label>
            <label for="idPedFecha">Fecha de entrega
                <input type="text" name="pedFecha" id="idPedFecha">
            </label>
            <label for="idPedHora">Hora de entrega
                <input type="text" name="pedHora" id="idPedHora">
            </label>
            <label for="idPedCliDni">Cliente frecuente DNI
                <input type="number" name="pedCliDni" id="idPedCliDni">
            </label>
            <label for="idPedProd">Producto ID
                <input type="number" name="pedProd" id="idPedProd">
            </label>
            <label for="idPedEmp">Empleado ID
                <input type="number" name="pedEmp" id="idPedEmp">
            </label>
            <!-- habria que cambiar la bdd para ingresar tambien el precio unitario, o no se,
            tal vez convenga traer el precio del id de producto, pero es un quilombooooooooooooo -->
        </form>
