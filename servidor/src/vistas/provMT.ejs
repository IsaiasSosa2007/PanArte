<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/main.css">
    <link rel="stylesheet" href="/csub.css">
    <title>Proveedor</title>
</head>
<body>
    <div class="contenedor">
        <header>
            <div class="divImg">
                <img src="/LogoPanArte.png" alt="">
            </div>
            <nav>
                <div>
                    <a href="/"><button>Home</button></a>
                    <a href="/clientes"><button>Clientes</button></a>
                    <a href="/empleados"><button>Empleados</button></a>
                    <a href="/proveedores"><button>Proveedores</button></a>
                </div>
                <div>
                    <a href="/ventas"><button>Ventas</button></a>
                    <a href="/pedidos"><button>Pedidos</button></a>
                    <a href="/productos"><button>Productos</button></a>
                    <a href="/ingredientes"><button>Ingrediente</button></a>
                    <a href="/recetas"><button>Recetas</button></a>
                </div>
            </nav>
        </header>
        <div class="divSubt">
            <h2>Mostrar Todo Proveedores</h2>
        </div>
        <nav class="navSub">
            <a href="/proveedores/alta"><button>Alta</button></a>
            <a href="/proveedores/baja"><button>Baja</button></a>
            <a href="/proveedores/mod"><button>Modificar</button></a>
            <a href="/proveedores/cons"><button>Consultar</button></a>
            <a href="/proveedores/mostrarTodo"><button>Mostrar Todo</button></a>
        </nav>
        <table>
            <thead>
                <tr>
                    <th>ID/nit</th>
                    <th>Nombre De Empresa</th>
                    <th>Telefono</th>
                    <th>Direccion</th>
                </tr>
            </thead>
            <tbody>
                <%
                if(registros.length>0){
                    registros.forEach(prov => { %>
                        <tr>
                            <td><%=prov['id/nit']%></td>
                            <td><%=prov.nombre_empresa%></td>
                            <td><%=prov.telefono%></td>
                            <td><%=prov.direccion%></td>
                        </tr>
                    <%});
                }
                else{%>
                <p>No hay ingredientes cargados</p><%}%>
            </tbody>
        </table>
    </div>
</body>
</html>