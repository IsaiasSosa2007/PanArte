<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/main.css">
    <link rel="stylesheet" href="/csub.css">
    <title>Modificar Cliente</title>
</head>
<body>
    <div class="contenedor">
        <header>
            <div class="divImg">
                <img src="/LogoPanArte.png" alt="">
            </div>
            <nav>
                <div>
                    <a href="/"><button>Home</button></a>
                    <a href="/clientes"><button>Clientes</button></a>
                    <a href="/empleados"><button>Empleados</button></a>
                    <a href="/proveedores"><button>Proveedores</button></a>
                </div>
                <div>
                    <a href="/ventas"><button>Ventas</button></a>
                    <a href="/pedidos"><button>Pedidos</button></a>
                    <a href="/productos"><button>Productos</button></a>
                    <a href="/ingredientes"><button>Ingrediente</button></a>
                    <a href="/recetas"><button>Recetas</button></a>
                </div>
            </nav>
        </header>
        <div class="divSubt">
            <h2>Modificar Clientes</h2>
        </div>
        <nav class="navSub">
            <a href="/clientes/alta"><button>Alta</button></a>
            <a href="/clientes/baja"><button>Baja</button></a>
            <a href="/clientes/mod"><button>Modificar</button></a>
            <a href="/clientes/cons"><button>Consultar</button></a>
            <a href="/clientes/mostrarTodo"><button>Mostrar Todo</button></a>
        </nav>

        <form onsubmit="buscar(event)">
            <label for="idCliIdBusq">ID del cliente a modificar:
                <input type="number" min="1" name="cliBusq" id="idCliIdBusq">
            </label>
            <input type="submit" value="Buscar">
        </form>

        <%if(mensaje!=""){%>
            <p><%=mensaje%></p>
        <%}%>

        <%if(cliente!=null){%>
            <!-- mismo formulario que el alta, pero con los datos ya cargados en value -->
            <form action="/clientes/mod/guardar" method="post">
                <p>ID: <%=cliente.id%></p>
                <input type="hidden" name="cliId" value="<%=cliente.id%>">
                <label for="idCliDni"> DNI
                    <input type="text" name="cliDni" id="idCliDni" value="<%=cliente.dni%>">
                </label>
                <label for="idCliNom">Nombre
                    <input type="text" name="cliNom" id="idCliNom" value="<%=cliente.nombre%>">
                </label>
                <label for="idCliApe">apellido
                    <input type="text" name="cliApe" id="idCliApe" value="<%=cliente.apellido%>">
                </label>
                <label for="idCliTel">Telefono
                    <input type="text" name="cliTel" id="idCliTel" value="<%=cliente.telefono%>">
                </label>
                <label for="idCliEmail">Email
                    <input type="text" name="cliEmail" id="idCliEmail" value="<%=cliente.email%>">
                </label>
                <label for="idCliDesc">Descuento
                    %<input type="number" name="cliDesc" id="idCliDesc" value="<%=cliente.descuento%>">
                </label>
                <input type="submit" value="Guardar cambios">
            </form>
        <%}%>

        <script>
            function buscar(event) {
                event.preventDefault();
                let cliBusq = document.getElementById('idCliIdBusq').value;
                window.location.href = `/clientes/mod/buscar/${cliBusq}`;
            }
        </script>
    </div>
</body>
</html>
