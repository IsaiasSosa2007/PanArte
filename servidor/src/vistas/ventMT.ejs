<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/main.css">
    <link rel="stylesheet" href="/csub.css">
    <title>Venta</title>
</head>
<body>
    <div class="contenedor">
        <header>
            <div class="divImg">
                <img src="/LogoPanArte.png" alt="">
            </div>
            <nav>
                <div>
                    <a href="/"><button>Home</button></a>
                    <a href="/clientes"><button>Clientes</button></a>
                    <a href="/empleados"><button>Empleados</button></a>
                    <a href="/proveedores"><button>Proveedores</button></a>
                </div>
                <div>
                    <a href="/ventas"><button>Ventas</button></a>
                    <a href="/pedidos"><button>Pedidos</button></a>
                    <a href="/productos"><button>Productos</button></a>
                    <a href="/ingredientes"><button>Ingrediente</button></a>
                    <a href="/recetas"><button>Recetas</button></a>
                </div>
            </nav>
        </header>
        <div class="divSubt">
            <h2>Mostrar Todo Ventas</h2>
        </div>
        <nav class="navSub">
            <a href="/ventas/alta"><button>Alta</button></a>
            <a href="/ventas/baja"><button>Baja</button></a>
            <a href="/ventas/mod"><button>Modificar</button></a>
            <a href="/ventas/cons"><button>Consultar</button></a>
            <a href="/ventas/mostrarTodo"><button>Mostrar Todo</button></a>
        </nav>
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Fecha</th>
                    <th>Hora</th>
                    <th>Total</th>
                    <th>Cantidad</th>
                    <th>Precio Uni Act</th>
                    <th>Sub Total</th>
                    <th>Descuento</th>
                    <th>Cliente ID</th>
                    <th>Empleado ID</th>
                    <th>Producto ID</th>
                </tr>
            </thead>
            <tbody>
                <%
                if(registros.length>0){
                    registros.forEach(vent => { 
                        let fecha=`${vent.fecha.getDate()}/${vent.fecha.getMonth()+1}/${vent.fecha.getFullYear()}`%>
                        <tr>
                            <td><%=vent.id_factura%></td>
                            <td><%=fecha%></td>
                            <td><%=vent.hora%></td>
                            <td><%=vent.total%></td>
                            <td><%=vent.cantidad_productos%></td>
                            <td><%=vent.precio_unit_actual%></td>
                            <td><%=vent.sub_total%></td>
                            <td><%=vent.descuento%></td>
                            <td><%=vent.clientes_frecuentes_id%></td>
                            <td><%=vent.empleados_id%></td>
                            <td><%=vent.productos_id%></td>
                        </tr>
                    <%});
                }
                else{%>
                <p>No hay ingredientes cargados</p><%}%>
            </tbody>
        </table>
    </div>
</body>
</html>